{
  "id": "jupyterlab",
  "name": "JupyterLab",
  "description": "Release-backed JupyterLab notebook service for Service Lasso.",
  "version": "1.0.0",
  "enabled": true,
  "execservice": "@python",
  "ports": {
    "service": 8888
  },
  "env": {
    "PYTHONUTF8": "1",
    "JUPYTERLAB_HOST": "127.0.0.1",
    "JUPYTERLAB_PORT": "${SERVICE_PORT}",
    "JUPYTERLAB_URL": "http://${JUPYTERLAB_HOST}:${JUPYTERLAB_PORT}",
    "SERVICE_DATA_PATH": "${SERVICE_ROOT}/notebooks",
    "JUPYTER_DATA_DIR": "${SERVICE_ROOT}/data",
    "JUPYTER_CONFIG_DIR": "${SERVICE_ROOT}/config",
    "JUPYTER_RUNTIME_DIR": "${SERVICE_ROOT}/runtime",
    "JUPYTERLAB_JSWORK_PATH": "${SERVICE_ROOT}/jswork",
    "JUPYTERLAB_WORKSPACES_DIR": "${SERVICE_ROOT}/workspaces"
  },
  "globalenv": {
    "JUPYTERLAB_URL": "${JUPYTERLAB_URL}",
    "JUPYTERLAB_PORT": "${JUPYTERLAB_PORT}"
  },
  "urls": [
    {
      "label": "JupyterLab",
      "url": "${JUPYTERLAB_URL}/lab",
      "kind": "local"
    },
    {
      "label": "health",
      "url": "${JUPYTERLAB_URL}/api",
      "kind": "local"
    }
  ],
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-jupyterlab",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-jupyterlab-1.0.0-win32.zip",
        "archiveType": "zip",
        "command": "./lasso-jupyterlab.py",
        "args": []
      }
    }
  },
  "commandline": {
    "win32": "${SERVICE_ARTIFACT_ROOT}/lasso-jupyterlab.py"
  },
  "actions": {
    "stop": {
      "commandline": {
        "win32": "${SERVICE_ARTIFACT_ROOT}/lasso-jupyterlab-stop.py"
      }
    }
  },
  "install": {
    "files": [
      {
        "path": "./notebooks/.keep",
        "content": ""
      },
      {
        "path": "./config/.keep",
        "content": ""
      },
      {
        "path": "./runtime/.keep",
        "content": ""
      },
      {
        "path": "./data/.keep",
        "content": ""
      },
      {
        "path": "./jswork/.keep",
        "content": ""
      },
      {
        "path": "./workspaces/.keep",
        "content": ""
      }
    ]
  },
  "healthcheck": {
    "type": "http",
    "url": "${JUPYTERLAB_URL}/api",
    "expected_status": 200,
    "retries": 180,
    "interval": 500
  },
  "depend_on": [
    "@python",
    "@node"
  ],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  }
}
